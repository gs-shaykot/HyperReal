generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  password               String?
  PhotoUrl               String?
  role                   Role      @default(USER)
  isBlocked              Boolean   @default(false)
  createdAt              DateTime  @default(now())
  isVerified             Boolean   @default(false)
  isCODDisabled          Boolean   @default(false)
  otp                    String?
  otpExpiry              DateTime?
  isNewUser              Boolean   @default(true)
  phone                  String?
  orderNotifications     Boolean   @default(true)
  marketingNotifications Boolean   @default(true)

  authProvider AuthProvider        @default(EMAIL)
  cart         Cart?
  orders       Order[]
  returnRequests ReturnRequest[]
  returnEvents ReturnEvent[] @relation("ReturnEventActor")
  reviewedReturns ReturnRequest[] @relation("ReturnReviewer")
  processedRefunds Refund[] @relation("RefundProcessor")
  wishlist     Wishlist[]
  addresses    Address[]
  sessions     Session[]
  reviews      Review[]
  reviewVotes  ReviewHelpfulVote[]

  assignedShipments Shipment[]           @relation("AssignedCourier")
  courierProfile    CourierProfile?
  trackingEvents    OrderTrackingEvent[] @relation("TrackingEventActor")

  @@map("user")
}

model Session {
  id        String @id @default(uuid())
  userId    String
  tokenHash String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  country String?
  region  String?
  city    String?

  userAgent      String?
  ipAddress      String?
  createdAt      DateTime @default(now())
  lastUsed       DateTime @default(now())
  expiresAt      DateTime
  sessionRevoked Boolean  @default(false)

  @@index([userId])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  street    String
  city      String
  zipCode   String
  country   String
  createdAt DateTime @default(now())
  fullName  String
  isDefault Boolean  @default(false)
  label     String?
  phone     String
  house     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("address")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("category")
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String
  searchKeywords  String[]         @default([])
  price           Float
  isAvailable     Boolean          @default(true)
  categoryId      String
  totalLikes      Int              @default(0)
  totalSold       Int              @default(0)
  createdAt       DateTime         @default(now())
  category        Category         @relation(fields: [categoryId], references: [id])
  productImages   ProductImage[]
  productVariants ProductVariant[]
  wishlists       Wishlist[]
  reviews         Review[]
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  size       String
  color      String
  hex        String?
  stock      Int
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id])
  wishlists  Wishlist[]

  @@unique([productId, size, color])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  imageUrl  String
  color     String?
  product   Product @relation(fields: [productId], references: [id])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String
  value       Float
  minSpend    Float
  maxDiscount Float?
  newUserOnly Boolean?
  limit       Int?
  usedCount   Int       @default(0)
  expiryDate  DateTime?
}

model Order {
  id             String               @id @unique @default(uuid())
  userId         String
  status         OrderStatus          @default(PENDING)
  orderCode      String               @unique
  checkoutKey    String?              @unique
  checkoutFingerprint String?
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderHistory   OrderHistory?
  orderItems     OrderItem[]
  payments       Payment[]
  shipment       Shipment?
  trackingEvents OrderTrackingEvent[]
  returnRequests ReturnRequest[]
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  variantId       String
  quantity        Int
  priceAtPurchase Float
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  returnItems     ReturnItem[]
}

model OrderHistory {
  id       String @id @default(uuid())
  orderId  String @unique
  fullName String
  street   String
  city     String
  house    String
  zipCode  String
  country  String
  phone    String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  method        PaymentMethod
  country       String        @default("Bangladesh")
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique

  paidAmountInUSD Float @default(0)
  paidAmountInBDT Float @default(0)

  totalProductPriceInUSD Float    @default(0)
  discount               Float    @default(0)
  shippingCost           Float    @default(0)
  createdAt              DateTime @default(now())
  shippingMethod         String?  @default("Standard Drop")
  couponCode             String?
  cardBrand              String?
  last4                  String?
  paymentIntentId        String?  @unique
  receiptUrl             String?
  checkoutUrl            String?
  sslSessionKey          String?
  stripeChargeId         String?  @unique
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}


model ReturnRequest {
  id            String       @id @default(uuid())
  returnCode    String       @unique
  orderId       String
  userId        String
  status        ReturnStatus @default(REQUESTED)
  reason        ReturnReason
  customerNote  String?
  adminNote     String?
  reviewedById  String?
  requestedAt   DateTime     @default(now())
  reviewedAt    DateTime?
  receivedAt    DateTime?
  inspectedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewer    User?        @relation("ReturnReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items       ReturnItem[]
  events      ReturnEvent[]
  refund      Refund?

  @@index([userId, createdAt])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model ReturnItem {
  id                String               @id @default(uuid())
  returnRequestId   String
  orderItemId       String
  requestedQuantity Int
  approvedQuantity  Int                  @default(0)
  receivedQuantity  Int                  @default(0)
  restockQuantity   Int                  @default(0)
  condition         ReturnItemCondition  @default(UNINSPECTED)
  inspectionNote    String?
  refundAmount      Decimal              @default(0) @db.Decimal(12, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnEvent {
  id              String          @id @default(uuid())
  returnRequestId String
  actorId         String?
  type            ReturnEventType
  title           String
  description     String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  actor         User?         @relation("ReturnEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([returnRequestId, createdAt])
}

model Refund {
  id               String       @id @default(uuid())
  returnRequestId  String       @unique
  method           RefundMethod
  status           RefundStatus @default(PENDING)
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("USD")
  idempotencyKey   String       @unique
  providerRefundId String?      @unique
  failureReason    String?
  processedById    String?
  initiatedAt      DateTime     @default(now())
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  processedBy  User?         @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Wishlist {
  id               String         @id @default(uuid())
  userId           String
  productId        String
  createdAt        DateTime       @default(now())
  productVariantId String
  product          Product        @relation(fields: [productId], references: [id])
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model HomepageMarquee {
  id          String   @id @default("homepage")
  messages    String[] @default([])
  isEnabled   Boolean  @default(true)
  scrollSpeed Int      @default(45)
  updatedAt   DateTime @updatedAt

  @@map("homepage_marquee")
}

model UpcomingRelease {
  id            String    @id @default("homepage")
  isEnabled     Boolean   @default(true)
  nameLine1     String    @default("Void")
  nameLine2     String    @default("Runner")
  version       String    @default("V3")
  description   String    @default("The next iteration of urban mobility.")
  countdownEnds DateTime?
  buttonLabel   String    @default("Set Reminder")
  updatedAt     DateTime  @updatedAt

  @@map("upcoming_release")
}

model OperationalCountry {
  id                       String    @id @default(uuid())
  name                     String
  code                     String    @unique
  phoneCode                String
  currencyCode             String
  currencySymbol           String
  shippingFeeUSD           Float     @default(10)
  freeShippingThresholdUSD Float     @default(150)
  currentExchangeRate      Float?
  previousExchangeRate     Float?
  exchangeRateDate         DateTime?
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("operational_country")
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  userId           String
  rating           Int
  headline         String
  body             String
  displayName      String
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  helpfulVotes ReviewHelpfulVote[]

  @@unique([userId, productId])
  @@index([productId, createdAt])
  @@index([productId, rating])
}

model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model Shipment {
  id                String            @id @default(uuid())
  orderId           String            @unique
  trackingCode      String            @unique @default(uuid())
  parcelTokenHash   String?           @unique
  fulfillmentStatus FulfillmentStatus @default(READY_TO_PACK)
  status            ShipmentStatus    @default(PENDING)

  assignedCourierId String?
  assignedCourier   User?   @relation("AssignedCourier", fields: [assignedCourierId], references: [id], onDelete: SetNull)
  deliveryZoneId    String?
  deliveryZone      DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  shippingType          String   @default("DOMESTIC")
  internationalStatus   String   @default("PREPARING")
  carrierName           String?
  carrierTrackingNumber String?
  estimatedDeliveryAt   DateTime?
  customsStatus         String   @default("NOT_REQUIRED")
  internationalNotes   String?

  otpHash       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?

  codCollected     Boolean   @default(false)
  codCollectedAt   DateTime?
  deliveryAttempts Int       @default(0)
  failureReason    String?
  deliveryNote     String?

  packedAt     DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemChecks ShipmentItemCheck[]
  events     OrderTrackingEvent[]

  @@index([fulfillmentStatus, createdAt])
  @@index([status, createdAt])
  @@index([assignedCourierId, status])
  @@index([deliveryZoneId, fulfillmentStatus])
}

model DeliveryZone {
  id        String   @id @default(uuid())
  name      String
  city      String
  country   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  couriers  CourierProfile[]
  shipments Shipment[]

  @@unique([name, city, country])
  @@index([city, country, isActive])
}

model CourierProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  courierCode String   @unique
  zoneId      String?
  vehicleType String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([zoneId, isActive])
}

model ShipmentItemCheck {
  id          String    @id @default(uuid())
  shipmentId  String
  orderItemId String
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([shipmentId, verified])
}

model OrderTrackingEvent {
  id          String            @id @default(uuid())
  orderId     String
  shipmentId  String?
  actorId     String?
  type        TrackingEventType
  title       String
  description String?
  location    String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  actor    User?     @relation("TrackingEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([shipmentId, createdAt])
}

enum Role {
  USER
  ADMIN
  MANAGER
  COURIER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  COD
  SSLC
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum CouponType {
  percent
  flat
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum FulfillmentStatus {
  READY_TO_PACK
  PACKING
  PACKED
  DISPATCHED
}

enum ShipmentStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum TrackingEventType {
  ORDER_CONFIRMED
  PACKING_STARTED
  ITEM_VERIFIED
  PACKED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERED
  NOTE_ADDED
}



enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTING
  REFUND_APPROVED
  REFUND_PROCESSING
  REFUNDED
  CLOSED
  CANCELLED
}

enum ReturnReason {
  WRONG_ITEM
  DAMAGED
  DEFECTIVE
  SIZE_ISSUE
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum ReturnItemCondition {
  UNINSPECTED
  SEALED
  GOOD
  DAMAGED
  DEFECTIVE
  MISSING_PARTS
}

enum ReturnEventType {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  MARKED_IN_TRANSIT
  RECEIVED
  INSPECTION_STARTED
  INSPECTED
  REFUND_APPROVED
  REFUND_INITIATED
  REFUND_SUCCEEDED
  REFUND_FAILED
  NOTE_ADDED
}

enum RefundMethod {
  STRIPE
  SSLC
  COD_MANUAL
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REQUIRES_MANUAL_ACTION
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}
